ordem_servico [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#2f5a8c"><tr><td colspan="3" bgcolor="#355f92"><font color="white"><b>ordem_servico</b></font></td></tr><tr><td align="left" width="50"><font color="#2f5a8c"><b>PK</b></font></td><td align="left"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left" width="50"><font color="#2f5a8c"><b>FK</b></font></td><td align="left">cliente_id</td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left" width="50"><font color="#2f5a8c"><b>FK</b></font></td><td align="left">endereco_id</td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left" width="50"><font color="#2f5a8c"><b>FK</b></font></td><td align="left">eletricista_id</td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left" width="50"> </td><td align="left">observacao</td><td align="left"><font color="#555555">TEXT</font></td></tr></table>>];
