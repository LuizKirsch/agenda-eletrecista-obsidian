endereco [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#2f5a8c"><tr><td colspan="3" bgcolor="#355f92"><font color="white"><b>endereco</b></font></td></tr><tr><td align="left" width="50"><font color="#2f5a8c"><b>PK</b></font></td><td align="left"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left" width="50"><font color="#2f5a8c"><b>FK</b></font></td><td align="left">cliente_id</td><td align="left"><font color="#555555">BIGINT</font></td></tr><tr><td align="left" width="50"> </td><td align="left">identificacao</td><td align="left"><font color="#555555">VARCHAR(60)</font></td></tr><tr><td align="left" width="50"> </td><td align="left">logradouro</td><td align="left"><font color="#555555">VARCHAR(150)</font></td></tr><tr><td align="left" width="50"> </td><td align="left">numero</td><td align="left"><font color="#555555">VARCHAR(10)</font></td></tr><tr><td align="left" width="50"> </td><td align="left">complemento</td><td align="left"><font color="#555555">VARCHAR(60)</font></td></tr><tr><td align="left" width="50"> </td><td align="left">bairro</td><td align="left"><font color="#555555">VARCHAR(80)</font></td></tr><tr><td align="left" width="50"> </td><td align="left">cidade</td><td align="left"><font color="#555555">VARCHAR(80)</font></td></tr><tr><td align="left" width="50"> </td><td align="left">ponto_referencia</td><td align="left"><font color="#555555">VARCHAR(150)</font></td></tr></table>>];
