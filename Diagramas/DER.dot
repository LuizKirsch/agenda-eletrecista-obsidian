digraph DER {
graph [rankdir=TB, nodesep=0.7, ranksep=1.0, splines=polyline, bgcolor=white, pad=0.4, dpi=150];
node [shape=plain, fontname="Carlito"]; edge [color="#555555", penwidth=1.3, dir=both, arrowsize=1.0];
