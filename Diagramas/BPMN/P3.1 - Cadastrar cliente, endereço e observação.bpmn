<bpmn:process id="P_P3.1" name="3.1 – Cadastrar cliente, endereço e observação" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_a</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Escolhe Novo cliente"/>
<bpmn:task id="N_a" name="Informa nome, telefone e, se houver, endereço e observação"/>
<bpmn:exclusiveGateway id="N_g1" name="Campos obrigatórios válidos e telefone único? (RN 37)"/>
<bpmn:task id="N_e" name="Exibe o erro no formulário"/>
<bpmn:task id="N_t" name="Grava cliente, endereço e observação; datas preenchidas pelo banco (RN 38)"/>
<bpmn:endEvent id="N_z" name="Cliente cadastrado"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_a"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_a" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_g1" targetRef="N_e" name="Não"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_e" targetRef="N_a" name="corrigir"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_g1" targetRef="N_t" name="Sim"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_t" targetRef="N_z"/>
