<bpmn:process id="P_P6.1" name="6.1 – Criar OS" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_a</bpmn:flowNodeRef><bpmn:flowNodeRef>N_c</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Interface (formulário)"><bpmn:flowNodeRef>N_b</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_2" name="Servidor (API e banco)"><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_d</bpmn:flowNodeRef><bpmn:flowNodeRef>N_f</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Clica em horário livre ou em Nova OS"/>
<bpmn:task id="N_a" name="Informa cliente, endereço, observações e atividades (tipo e início)"/>
<bpmn:task id="N_b" name="Calcula o fim pela duração padrão do tipo (RN 2)"/>
<bpmn:task id="N_c" name="Confirma a criação da OS"/>
<bpmn:exclusiveGateway id="N_g1" name="Dados válidos? (RN 1, 3, 34, 40)"/>
<bpmn:task id="N_e1" name="Exibe o erro no formulário"/>
<bpmn:task id="N_d" name="Grava OS e atividades como 'agendada' (RN 4), sequência 1 a N"/>
<bpmn:task id="N_f" name="Verifica conflito e registra aviso sem bloquear (RN 10, 11)"/>
<bpmn:endEvent id="N_z" name="Agenda atualizada"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_a"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_a" targetRef="N_b"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_b" targetRef="N_c"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_c" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_g1" targetRef="N_e1" name="Não"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_e1" targetRef="N_a" name="corrigir"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_g1" targetRef="N_d" name="Sim"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_d" targetRef="N_f"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_f" targetRef="N_z"/>
