<bpmn:process id="P_P2.3" name="2.3 – Cadastrar, editar e excluir usuário" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Secretária"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_a1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_gs</bpmn:flowNodeRef><bpmn:flowNodeRef>N_bl</bpmn:flowNodeRef><bpmn:flowNodeRef>N_ga</bpmn:flowNodeRef><bpmn:flowNodeRef>N_a2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_a3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z3</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Acessa a listagem de usuários (só a secretária cadastra, edita e exclui, RN 29)"/>
<bpmn:exclusiveGateway id="N_g1" name="Qual ação?"/>
<bpmn:task id="N_a1" name="Valida e grava o novo usuário (processo 2.2)"/>
<bpmn:endEvent id="N_z1" name="Usuário cadastrado"/>
<bpmn:exclusiveGateway id="N_gs" name="Exclui, desativa ou muda o perfil do próprio usuário? (RN 31)"/>
<bpmn:endEvent id="N_bl" name="Ação bloqueada"/>
<bpmn:exclusiveGateway id="N_ga" name="Ação escolhida"/>
<bpmn:task id="N_a2" name="Grava as alterações; senha em branco mantém a atual (RN 30)"/>
<bpmn:endEvent id="N_z2" name="Usuário atualizado"/>
<bpmn:task id="N_a3" name="Pede confirmação e remove o registro definitivamente (RN 32)"/>
<bpmn:endEvent id="N_z3" name="Usuário excluído"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g1" targetRef="N_a1" name="Cadastrar"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_a1" targetRef="N_z1"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_g1" targetRef="N_gs" name="Editar/excluir"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_gs" targetRef="N_bl" name="Sim"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_gs" targetRef="N_ga" name="Não"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_ga" targetRef="N_a2" name="Editar"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_a2" targetRef="N_z2"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_ga" targetRef="N_a3" name="Excluir"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_a3" targetRef="N_z3"/>
