<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef></bpmn:lane>
