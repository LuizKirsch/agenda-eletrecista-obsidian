<bpmn:endEvent id="N_z2" name="OS concluída"/>
<bpmn:task id="N_t1" name="Passa a atividade agendada para concluída ou cancelada"/>
<bpmn:endEvent id="N_z1" name="Atividade travada para arraste (RN 12)"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g1"/>
