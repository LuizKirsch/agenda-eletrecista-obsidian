<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P4.3" targetNamespace="http://agenda.local/bpmn">
<bpmn:process id="P_P4.3" name="4.3 – Editar e excluir orçamento" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_ro</bpmn:flowNodeRef><bpmn:flowNodeRef>N_sv</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_c</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z2</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Seleciona orçamento na listagem"/>
<bpmn:exclusiveGateway id="N_g1" name="Orçamento está pendente? (RN 54)"/>
<bpmn:endEvent id="N_ro" name="Exibido somente para leitura"/>
<bpmn:exclusiveGateway id="N_g2" name="Editar ou excluir?"/>
<bpmn:task id="N_e" name="Altera os dados do orçamento"/>
<bpmn:task id="N_sv" name="Valida pelas regras da montagem e salva (RN 44 a 49)"/>
<bpmn:endEvent id="N_z1" name="Orçamento atualizado"/>
<bpmn:task id="N_c" name="Pede confirmação e remove o orçamento e seus itens de serviço (RN 55)"/>
<bpmn:endEvent id="N_z2" name="Orçamento excluído"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g1" targetRef="N_ro" name="Não"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_g1" targetRef="N_g2" name="Sim"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_g2" targetRef="N_e" name="Editar"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_e" targetRef="N_sv"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_sv" targetRef="N_z1"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_g2" targetRef="N_c" name="Excluir"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_c" targetRef="N_z2"/>
</bpmn:process><bpmndi:BPMNDiagram id="D1"><bpmndi:BPMNPlane id="PL1" bpmnElement="P_P4.3">
