<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P2.4" targetNamespace="http://agenda.local/bpmn">
<bpmn:process id="P_P2.4" name="2.4 – Criar usuário inicial" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Migration"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Banco de dados"><bpmn:flowNodeRef>N_ins</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Executa a migration da tabela usuario"/>
<bpmn:exclusiveGateway id="N_g" name="Variáveis de ambiente de nome, login e senha definidas? (RN 33)"/>
<bpmn:endEvent id="N_e" name="Migration falha; nenhum usuário é criado"/>
<bpmn:task id="N_ins" name="Insere a secretária com senha em hash (RN 28, RN 33)"/>
<bpmn:endEvent id="N_z" name="Usuário inicial criado"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g" targetRef="N_e" name="Não"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_g" targetRef="N_ins" name="Sim"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_ins" targetRef="N_z"/>
</bpmn:process><bpmndi:BPMNDiagram id="D1"><bpmndi:BPMNPlane id="PL1" bpmnElement="P_P2.4">
