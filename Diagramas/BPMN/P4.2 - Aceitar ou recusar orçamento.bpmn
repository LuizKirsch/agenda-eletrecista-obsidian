<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P4.2" targetNamespace="http://agenda.local/bpmn">
<bpmn:process id="P_P4.2" name="4.2 – Aceitar ou recusar orçamento" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_c</bpmn:flowNodeRef><bpmn:flowNodeRef>N_aj</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g5</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_ro</bpmn:flowNodeRef><bpmn:flowNodeRef>N_rec</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_w</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g4</bpmn:flowNodeRef><bpmn:flowNodeRef>N_o</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_r</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z1</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Abre um orçamento"/>
<bpmn:exclusiveGateway id="N_g1" name="Orçamento está pendente? (RN 50)"/>
<bpmn:endEvent id="N_ro" name="Exibido somente para leitura"/>
<bpmn:exclusiveGateway id="N_g2" name="Aceitar ou recusar?"/>
<bpmn:task id="N_c" name="Escolhe o eletricista e informa a data e o horário de início (RN 51)"/>
<bpmn:task id="N_rec" name="Recomenda data e início de cada atividade no primeiro intervalo livre do eletricista, na ordem dos itens (RN 67)"/>
<bpmn:task id="N_aj" name="Revisa as sugestões; pode trocar o eletricista, a data ou o início de cada atividade (RN 51, 67)"/>
<bpmn:exclusiveGateway id="N_g3" name="Cada atividade cabe no próprio dia? (RN 52)"/>
<bpmn:endEvent id="N_w" name="OS não gerada; orçamento continua pendente e usuário avisado"/>
<bpmn:exclusiveGateway id="N_g4" name="Surgiu conflito desde a recomendação? (RN 68)"/>
<bpmn:exclusiveGateway id="N_g5" name="Recalcular ou gerar mesmo assim? (RN 68)"/>
<bpmn:task id="N_o" name="Gera a OS com uma atividade agendada por item, com o eletricista de cada uma; marca como aceito (RN 51, 53)"/>
<bpmn:endEvent id="N_z2" name="Orçamento aceito e OS gerada"/>
<bpmn:task id="N_r" name="Marca como recusado; o status não muda mais (RN 50)"/>
<bpmn:endEvent id="N_z1" name="Orçamento recusado"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g1" targetRef="N_ro" name="Não"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_g1" targetRef="N_g2" name="Sim"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_g2" targetRef="N_c" name="Aceitar"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_c" targetRef="N_rec"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_rec" targetRef="N_aj"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_aj" targetRef="N_g3"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_g3" targetRef="N_w" name="Não"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_g3" targetRef="N_g4" name="Sim"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_g4" targetRef="N_o" name="Não"/>
<bpmn:sequenceFlow id="F_10" sourceRef="N_g4" targetRef="N_g5" name="Sim"/>
<bpmn:sequenceFlow id="F_11" sourceRef="N_g5" targetRef="N_rec" name="Recalcular"/>
<bpmn:sequenceFlow id="F_12" sourceRef="N_g5" targetRef="N_o" name="Gerar mesmo assim"/>
<bpmn:sequenceFlow id="F_13" sourceRef="N_o" targetRef="N_z2"/>
<bpmn:sequenceFlow id="F_14" sourceRef="N_g2" targetRef="N_r" name="Recusar"/>
<bpmn:sequenceFlow id="F_15" sourceRef="N_r" targetRef="N_z1"/>
