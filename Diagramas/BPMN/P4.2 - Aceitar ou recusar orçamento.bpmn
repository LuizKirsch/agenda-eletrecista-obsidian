<bpmn:process id="P_P4.2" name="4.2 – Aceitar ou recusar orçamento" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_c</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_ro</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_w</bpmn:flowNodeRef><bpmn:flowNodeRef>N_o</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_r</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z1</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Abre um orçamento"/>
<bpmn:exclusiveGateway id="N_g1" name="Orçamento está pendente? (RN 50)"/>
<bpmn:endEvent id="N_ro" name="Exibido somente para leitura"/>
<bpmn:exclusiveGateway id="N_g2" name="Aceitar ou recusar?"/>
<bpmn:task id="N_c" name="Informa data e horário de início das atividades (RN 51)"/>
<bpmn:exclusiveGateway id="N_g3" name="Atividades encadeadas cabem no dia? (RN 51, 52)"/>
<bpmn:endEvent id="N_w" name="OS não gerada; orçamento continua pendente e usuário avisado"/>
<bpmn:task id="N_o" name="Gera OS com cliente, endereço e uma atividade agendada por item; marca como aceito (RN 51, 53)"/>
<bpmn:endEvent id="N_z2" name="Orçamento aceito e OS gerada"/>
<bpmn:task id="N_r" name="Marca como recusado; o status não muda mais (RN 50)"/>
<bpmn:endEvent id="N_z1" name="Orçamento recusado"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g1" targetRef="N_ro" name="Não"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_g1" targetRef="N_g2" name="Sim"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_g2" targetRef="N_c" name="Aceitar"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_c" targetRef="N_g3"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_g3" targetRef="N_w" name="Não"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_g3" targetRef="N_o" name="Sim"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_o" targetRef="N_z2"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_g2" targetRef="N_r" name="Recusar"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_r" targetRef="N_z1"/>
