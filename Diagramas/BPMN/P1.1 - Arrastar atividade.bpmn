<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P1.1" targetNamespace="http://agenda.local/bpmn">
<bpmn:process id="P_P1.1" name="1.1 – Arrastar atividade" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_u</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z0</bpmn:flowNodeRef><bpmn:flowNodeRef>N_a</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_r</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z2</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Arrasta um bloco da agenda para outro dia ou horário"/>
<bpmn:exclusiveGateway id="N_g1" name="Atividade agendada? (RN 5)"/>
<bpmn:endEvent id="N_z0" name="Arraste bloqueado"/>
<bpmn:task id="N_a" name="Ajusta o novo horário a intervalos de 15 min, iniciando e terminando no mesmo dia (RN 7)"/>
<bpmn:exclusiveGateway id="N_g2" name="OS tem mais de uma atividade agendada?"/>
<bpmn:task id="N_u" name="Escolhe remarcar a OS inteira, só a atividade ou cancelar o arraste"/>
<bpmn:endEvent id="N_z1" name="Segue 6.2 (OS inteira) ou 6.3 (só a atividade)"/>
<bpmn:task id="N_r" name="Remarca a atividade (processo 6.3)"/>
<bpmn:endEvent id="N_z2" name="Agenda atualizada"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g1" targetRef="N_z0" name="Não"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_g1" targetRef="N_a" name="Sim"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_a" targetRef="N_g2"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_g2" targetRef="N_u" name="Sim"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_u" targetRef="N_z1"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_g2" targetRef="N_r" name="Não"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_r" targetRef="N_z2"/>
</bpmn:process><bpmndi:BPMNDiagram id="D1"><bpmndi:BPMNPlane id="PL1" bpmnElement="P_P1.1">
