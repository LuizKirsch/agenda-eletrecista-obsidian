<bpmn:process id="P_P3.3" name="3.3 – Editar e excluir cliente, endereço e observação" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_ed</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_gv</bpmn:flowNodeRef><bpmn:flowNodeRef>N_er</bpmn:flowNodeRef><bpmn:flowNodeRef>N_sv</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_gx</bpmn:flowNodeRef><bpmn:flowNodeRef>N_bl</bpmn:flowNodeRef><bpmn:flowNodeRef>N_cf</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z3</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Seleciona cliente, endereço ou observação"/>
<bpmn:exclusiveGateway id="N_g1" name="Editar ou excluir?"/>
<bpmn:task id="N_ed" name="Altera os dados"/>
<bpmn:exclusiveGateway id="N_gv" name="Dados válidos conforme o cadastro? (RN 41, RN 37)"/>
<bpmn:endEvent id="N_er" name="Erro exibido no formulário"/>
<bpmn:task id="N_sv" name="Salva; a observação mantém a data de registro original (RN 41)"/>
<bpmn:endEvent id="N_z1" name="Dados atualizados"/>
<bpmn:exclusiveGateway id="N_gx" name="Cliente ou endereço com OS vinculada? (RN 42)"/>
<bpmn:endEvent id="N_bl" name="Exclusão bloqueada"/>
<bpmn:task id="N_cf" name="Pede confirmação e exclui; cliente leva endereços e observações, endereço leva observações (RN 42, RN 43)"/>
<bpmn:endEvent id="N_z3" name="Registro excluído"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g1" targetRef="N_ed" name="Editar"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_ed" targetRef="N_gv"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_gv" targetRef="N_er" name="Não"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_gv" targetRef="N_sv" name="Sim"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_sv" targetRef="N_z1"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_g1" targetRef="N_gx" name="Excluir"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_gx" targetRef="N_bl" name="Sim"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_gx" targetRef="N_cf" name="Não"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_cf" targetRef="N_z3"/>
