<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P5.1" targetNamespace="http://agenda.local/bpmn">
<bpmn:process id="P_P5.1" name="5.1 – Gerenciar tipos de atividade" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g0</bpmn:flowNodeRef><bpmn:flowNodeRef>N_a</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z</bpmn:flowNodeRef><bpmn:flowNodeRef>N_gd</bpmn:flowNodeRef><bpmn:flowNodeRef>N_bd</bpmn:flowNodeRef><bpmn:flowNodeRef>N_d</bpmn:flowNodeRef><bpmn:flowNodeRef>N_zd</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Acessa o gerenciamento de tipos"/>
<bpmn:exclusiveGateway id="N_g0" name="Qual ação?"/>
<bpmn:task id="N_a" name="Informa nome, duração padrão (5 a 720 min) e valor padrão opcional"/>
<bpmn:exclusiveGateway id="N_g1" name="Nome único (sem diferenciar maiúsculas) e dados válidos? (RN 17)"/>
<bpmn:endEvent id="N_e" name="Erro exibido no formulário"/>
<bpmn:task id="N_t" name="Grava o tipo; nova duração vale só para novas sugestões (RN 18)"/>
<bpmn:endEvent id="N_z" name="Tipo salvo"/>
<bpmn:exclusiveGateway id="N_gd" name="Restará ao menos um tipo ativo? (RN 21)"/>
<bpmn:endEvent id="N_bd" name="Desativação bloqueada"/>
<bpmn:task id="N_d" name="Desativa: o tipo não é excluído, some das novas atividades e permanece nas OS (RN 19, RN 20)"/>
<bpmn:endEvent id="N_zd" name="Tipo desativado"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g0"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g0" targetRef="N_a" name="Cadastrar
ou editar"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_a" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_g1" targetRef="N_e" name="Não"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_g1" targetRef="N_t" name="Sim"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_t" targetRef="N_z"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_g0" targetRef="N_gd" name="Desativar"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_gd" targetRef="N_bd" name="Não"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_gd" targetRef="N_d" name="Sim"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_d" targetRef="N_zd"/>
</bpmn:process><bpmndi:BPMNDiagram id="D1"><bpmndi:BPMNPlane id="PL1" bpmnElement="P_P5.1">
