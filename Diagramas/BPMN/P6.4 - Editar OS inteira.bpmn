<bpmn:startEvent id="N_s" name="Abre a OS e escolhe Editar"/>
<bpmn:task id="N_a" name="Altera cliente, endereço, observações e atividades agendadas (concluídas e canceladas só para leitura, RN 9)"/>
<bpmn:exclusiveGateway id="N_g" name="Dados válidos e ao menos uma atividade? (RN 1, 9, 34)"/>
<bpmn:task id="N_e" name="Exibe o erro e mantém o formulário aberto"/>
<bpmn:task id="N_u" name="Grava as alterações e renumera a sequência de 1 a N (RN 35)"/>
<bpmn:task id="N_c" name="Verifica conflito e avisa sem bloquear (RN 10, 11)"/>
