<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_gx</bpmn:flowNodeRef><bpmn:flowNodeRef>N_ro</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e</bpmn:flowNodeRef><bpmn:flowNodeRef>N_u</bpmn:flowNodeRef><bpmn:flowNodeRef>N_c</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z</bpmn:flowNodeRef></bpmn:lane>
