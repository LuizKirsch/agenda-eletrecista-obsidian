<bpmn:process id="P_P6.2" name="6.2 – Remarcar OS inteira" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_g0</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e0</bpmn:flowNodeRef><bpmn:flowNodeRef>N_s2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_n2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_f2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z</bpmn:flowNodeRef><bpmn:flowNodeRef>N_s3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z3</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Arrasta uma atividade de OS com mais de uma atividade agendada"/>
<bpmn:exclusiveGateway id="N_g0" name="Atividade agendada? (RN 5)"/>
<bpmn:endEvent id="N_e0" name="Arraste não permitido"/>
<bpmn:exclusiveGateway id="N_g1" name="Remarcar a OS inteira ou só a atividade? (RN 6)"/>
<bpmn:task id="N_s2" name="Mantém a arrastada no horário solto e encadeia as demais agendadas no mesmo dia, na ordem (RN 6)"/>
<bpmn:exclusiveGateway id="N_g2" name="Encadeamento cabe no dia? (RN 6)"/>
<bpmn:endEvent id="N_n2" name="Nada é alterado e o usuário é avisado"/>
<bpmn:task id="N_f2" name="Grava os novos horários; concluídas e canceladas ficam inalteradas"/>
<bpmn:endEvent id="N_z" name="OS remarcada"/>
<bpmn:task id="N_s3" name="Remarca somente a atividade arrastada (processo 6.3)"/>
<bpmn:endEvent id="N_z3" name="Atividade remarcada"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_g0"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_g0" targetRef="N_e0" name="Não"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_g0" targetRef="N_g1" name="Sim"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_g1" targetRef="N_s2" name="OS inteira"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_g1" targetRef="N_s3" name="Só a atividade"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_s2" targetRef="N_g2"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_g2" targetRef="N_n2" name="Não"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_g2" targetRef="N_f2" name="Sim"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_f2" targetRef="N_z"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_s3" targetRef="N_z3"/>
