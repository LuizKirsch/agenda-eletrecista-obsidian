<bpmn:process id="P_P6.2" name="6.2 – Remarcar OS inteira" isExecutable="false">
<bpmn:laneSet id="LS1">
<bpmn:lane id="L_0" name="Usuário"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_1" name="Sistema"><bpmn:flowNodeRef>N_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g</bpmn:flowNodeRef><bpmn:flowNodeRef>N_n</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_z</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="OS inteira escolhida no arraste (processo 1.1)"/>
<bpmn:task id="N_t1" name="Mantém a arrastada no horário em que foi solta e encadeia as demais agendadas no mesmo dia, na ordem, sem intervalos (RN 6)"/>
<bpmn:exclusiveGateway id="N_g" name="Encadeamento cabe no dia? (RN 6)"/>
<bpmn:endEvent id="N_n" name="Nada é alterado e o usuário é avisado (RN 6)"/>
<bpmn:task id="N_t2" name="Grava os novos horários; concluídas e canceladas ficam inalteradas (RN 6)"/>
<bpmn:endEvent id="N_z" name="OS remarcada"/>
<bpmn:sequenceFlow id="F_0" sourceRef="N_s" targetRef="N_t1"/>
<bpmn:sequenceFlow id="F_1" sourceRef="N_t1" targetRef="N_g"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_g" targetRef="N_n" name="Não"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_g" targetRef="N_t2" name="Sim"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_t2" targetRef="N_z"/>
