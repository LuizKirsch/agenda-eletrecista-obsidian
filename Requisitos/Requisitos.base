filters:
  and:
    - file.hasTag("requisito")
    - file.ext == "md"
views:
  - type: table
    name: Todos
    filters:
      and:
        - id != null
    groupBy:
      property: modulo
      direction: ASC
    order:
      - file.name
      - modulo
      - prioridade
      - alterado
      - entrega
      - implementacao
  - type: table
    name: Alterados por decisão
    filters:
      and:
        - alterado == true
    order:
      - file.name
      - modulo
      - prioridade
  - type: table
    name: Prioridade alta
    filters:
      and:
        - prioridade == "Alta"
    order:
      - file.name
      - modulo
  - type: table
    name: Implementação
    filters:
      and:
        - implementacao != "completa"
    groupBy:
      property: implementacao
      direction: ASC
    order:
      - file.name
      - modulo
      - prioridade
      - entrega
      - implementacao
